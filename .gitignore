# No trailing slash: a trailing slash matches directories only, and a symlinked
# node_modules — which is how playwright often gets pointed at for tools/test-browser.mjs
# — would slip straight past it and be committed as a link into somebody's scratch dir.
node_modules
dist/
.DS_Store

# Throwaway prototypes, rebuilt on demand from tools/. The repository root is the
# published site, so a rough rule set landing here would go live for anyone with
# the link. Build them, play them, leave them untracked.
prototype/
